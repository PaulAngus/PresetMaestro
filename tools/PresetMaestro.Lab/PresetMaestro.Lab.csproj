<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <PropertyGroup Condition="'$(MaestroTestProfile)' == 'PhysicalMac'"><DefineConstants>$(DefineConstants);MAESTRO_PHYSICAL_MAC</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(MaestroTestProfile)' == 'PhysicalWindows'"><DefineConstants>$(DefineConstants);MAESTRO_PHYSICAL_WINDOWS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(MaestroTestProfile)' == 'PhysicalMac' or '$(MaestroTestProfile)' == 'PhysicalWindows'"><DefineConstants>$(DefineConstants);MAESTRO_PHYSICAL_HARDWARE</DefineConstants></PropertyGroup>
  <ItemGroup><Using Remove="MightBeUseful.Midi" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabProfile)' == 'OfflineWindows'"><Compile Remove="Program.cs" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabProfile)' != 'OfflineWindows'"><Compile Remove="OfflineProgram.cs" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabAgentProject)' == '' and '$(TestLabProfile)' != 'OfflineWindows'"><PackageReference Include="ApplicationTestLab.Agent" Version="[0.2.5]" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabAgentProject)' == '' and '$(TestLabProfile)' == 'OfflineWindows'"><PackageReference Include="ApplicationTestLab.Agent" Version="[0.2.5]" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabAgentProject)' != ''"><ProjectReference Include="$(TestLabAgentProject)" /></ItemGroup>
</Project>
