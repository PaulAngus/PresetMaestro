# Keep binary assets untouched and source formatting identical on both build hosts.
* text=auto
# The existing C# formatter requires CRLF; make Mac checkouts obey it too.
*.cs text eol=crlf
*.csx text eol=crlf

# Preserve compressed PDF streams and byte offsets on every checkout.
*.pdf binary

# Preserve exact bytes covered by the vendored Test Lab checksum manifest.
dependencies/test-lab/** -text
