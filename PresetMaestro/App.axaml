<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PresetMaestro.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <!-- Compact tag rows retain Fluent's checked, hover, disabled and focus states. -->
    <Style Selector="CheckBox.favoriteTag">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="RootGrid" ColumnDefinitions="16,*" Background="Transparent">
            <Border x:Name="PART_Border" Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Border x:Name="NormalRectangle" CornerRadius="2"
                      BorderThickness="{DynamicResource CheckBoxBorderThemeThickness}"
                      BorderBrush="{DynamicResource CheckBoxCheckBackgroundStrokeUnchecked}"
                      Background="{DynamicResource CheckBoxCheckBackgroundFillUnchecked}" />
              <Path x:Name="CheckGlyph" Opacity="0" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource CheckBoxCheckGlyphForegroundUnchecked}"
                    FlowDirection="LeftToRight" />
            </Grid>
            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True" TextWrapping="NoWrap"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Window">
      <Setter Property="Icon" Value="/preset_maestro.ico" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown, AutoCompleteBox">
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
  </Application.Styles>
</Application>
