<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(TestLabProfile)' == 'OfflineWindows'">
    <DefineConstants>$(DefineConstants);MAESTRO_OFFLINE_NO_MIDI</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <EnableFractalIndex Condition="'$(EnableFractalIndex)' == ''">true</EnableFractalIndex>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>PresetMaestro</AssemblyName>
    <AssemblyTitle>Preset Maestro</AssemblyTitle>
    <RootNamespace>PresetMaestro</RootNamespace>
    <Product>Preset Maestro</Product>
    <Title>Preset Maestro</Title>
    <ApplicationIcon Condition="'$(MaestroPlatform)' == 'Windows'">preset_maestro.ico</ApplicationIcon>
    <_RequestedPublishVersion>$(PublishVersion)</_RequestedPublishVersion>
    <_RequestedPublishVersion Condition="'$(_RequestedPublishVersion)' == '' and '$(Version)' != ''">$(Version)</_RequestedPublishVersion>
    <AppVersionFile Condition="'$(AppVersionFile)' == ''">$(MSBuildProjectDirectory)\Version.txt</AppVersionFile>
    <AppVersion>$([System.IO.File]::ReadAllText('$(AppVersionFile)').Trim())</AppVersion>
    <Version>$(AppVersion)</Version>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(MaestroPlatform)' == 'Windows'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(MaestroPlatform)' == 'macOS' and $([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">osx-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(MaestroPlatform)' == 'macOS'">osx-arm64</RuntimeIdentifier>
    <PublishDir Condition="'$(MaestroPlatform)' == 'Windows'">../publish/</PublishDir>
    <PublishDir Condition="'$(MaestroPlatform)' == 'macOS'">../publish-macos/$(RuntimeIdentifier)/raw/</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile Condition="'$(MaestroPlatform)' == 'Windows'">true</PublishSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(MaestroPlatform)' == 'Windows'">true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun Condition="'$(MaestroPlatform)' == 'Windows'">true</PublishReadyToRun>
    <EnableCompressionInSingleFile Condition="'$(MaestroPlatform)' == 'Windows'">true</EnableCompressionInSingleFile>
    <!-- An ordinary self-contained bundle allows each Mac native binary to be signed. -->
    <PublishSingleFile Condition="'$(MaestroPlatform)' == 'macOS'">false</PublishSingleFile>
    <PublishReadyToRun Condition="'$(MaestroPlatform)' == 'macOS'">false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MightBeUseful.Midi" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <ProjectReference Include="$(SharedMidiSourceRoot)/src/MightBeUseful.Midi/MightBeUseful.Midi.csproj" Condition="'$(SharedMidiSourceRoot)' != ''" />
    <AvaloniaResource Include="preset_maestro.ico" />
    <AvaloniaResource Include="preset_maestro.png" />
    <ProjectReference Include="..\PresetNameSync.Core\PresetNameSync.Core.csproj" />
    <ProjectReference Include="..\PresetMaestro.FractalIndex\PresetMaestro.FractalIndex.csproj" Condition="'$(EnableFractalIndex)' == 'true'" />
    <!-- Never use Avalonia.Desktop or NAudio umbrella packages: backends are selected below. -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(MaestroPlatform)' == 'Windows'">
    <PackageReference Include="MightBeUseful.Midi.Windows" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <ProjectReference Include="$(SharedMidiSourceRoot)/src/MightBeUseful.Midi.Windows/MightBeUseful.Midi.Windows.csproj" Condition="'$(SharedMidiSourceRoot)' != ''" />
    <PackageReference Include="Avalonia.Win32" Version="11.2.3" />
    <Compile Remove="Platforms/macOS/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MaestroPlatform)' == 'macOS'">
    <PackageReference Include="MightBeUseful.Midi.CoreMidi" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <PackageReference Include="MightBeUseful.Midi.Rtp" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <ProjectReference Include="$(SharedMidiSourceRoot)/src/MightBeUseful.Midi.CoreMidi/MightBeUseful.Midi.CoreMidi.csproj" Condition="'$(SharedMidiSourceRoot)' != ''" />
    <PackageReference Include="Avalonia.Native" Version="11.2.3" />
    <!-- 8.x's build targets copy Windows DLLs too. Opt out and select only the Mac asset. -->
    <Compile Remove="Platforms/Windows/**/*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableFractalIndex)' == 'true'">
    <DefineConstants>$(DefineConstants);FRACTAL_INDEX</DefineConstants>
  </PropertyGroup>

  <Import Project="..\scripts\PublishVersion.targets" />
  <Import Project="../build/PlatformPublish.targets" />

</Project>
