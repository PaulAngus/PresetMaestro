<Project>
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>
  <Import Project="build/DesktopPlatform.props" Condition="'$(MSBuildProjectName)' == 'PresetMaestro' or '$(MSBuildProjectName)' == 'PresetMaestro.Tests'" />
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PresetMaestro' or '$(MSBuildProjectName)' == 'PresetMaestro.Tests'"><Using Include="MightBeUseful.Midi" /></ItemGroup>
  <Import Project="dependencies/midi/MidiVersion.props" />
</Project>
