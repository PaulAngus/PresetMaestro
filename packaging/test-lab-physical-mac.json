{
  "applicationId": "preset-maestro",
  "applicationName": "PresetMaestro",
  "testProfile": "physical-mac-existing-midi-only",
  "runner": {
    "project": "tools/PresetMaestro.Lab/PresetMaestro.Lab.csproj",
    "destination": "bin/lab",
    "executable": "bin/lab/PresetMaestro.Lab"
  },
  "platforms": {
    "osx": {
      "tests": [
        {
          "project": "tools/PresetMaestro.LabTests/PresetMaestro.LabTests.csproj",
          "destination": "bin/tests"
        },
        {
          "project": "tools/PresetMaestro.Pilot/PresetMaestro.Pilot.csproj",
          "destination": "bin/Maestro Physical Desktop Tests.app/Contents/MacOS",
          "macApplication": {
            "executable": "PresetMaestro.Pilot",
            "name": "Maestro Physical Desktop Tests",
            "identifier": "com.mightbeuseful.presetmaestro.physicaldesktoptests",
            "runtimeFromExecutable": "../../../maestro-physical-pilot-runtime"
          }
        },
        {
          "project": "PresetMaestro/PresetMaestro.csproj",
          "destination": "bin/Preset Maestro.app/Contents/MacOS",
          "macApplication": {
            "executable": "PresetMaestro",
            "name": "Preset Maestro",
            "identifier": "com.mightbeuseful.presetmaestro.testapplication",
            "backgroundAgent": false
          }
        }
      ],
      "properties": [
        "-p:MaestroPlatform=macOS",
        "-p:MaestroTestProfile=PhysicalMac"
      ]
    }
  },
  "appVersionFile": "PresetMaestro/Version.txt",
  "agentVersion": "0.2.5",
  "macUpgradeRetainedPaths": [
    "bin/Maestro Physical Desktop Tests.app",
    "bin/maestro-physical-pilot-runtime",
    "bin/Preset Maestro.app"
  ]
}
